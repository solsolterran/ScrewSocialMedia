# ScrewSocialMedia credentials.
#
# Copy only the values you need into the repository .env file.
# Missing values should fail only the command that needs them.
# Do not put stable captions, API paths, or user-agent format values in env.

# Twitter text and link posting.
X_CONSUMER_KEY=
X_CONSUMER_KEY_SECRET=
X_USER_ACCESS_TOKEN=
X_USER_ACCESS_TOKEN_SECRET=

# Bluesky text and link posting.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Reddit link and self-post submission.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USERNAME=

# Facebook Page / Instagram publishing.
# This Page token is used by both Facebook and Instagram Graph API posting.
META_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_USER_ID=

# YouTube upload support.
# Local OAuth files, not stable app settings.
YOUTUBE_CLIENT_SECRETS_FILE=
YOUTUBE_TOKEN_FILE=

# TikTok direct video posting.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# Snapchat Public Profile API posting.
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_REFRESH_TOKEN=
SNAPCHAT_PUBLIC_PROFILE_ID=
